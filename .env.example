# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=naja7t_db

# App Settings
APP_NAME=Naja7t API Server
FRONTEND_URL=https://naja7t.com

# Chargily Pay Configuration (V2)
# احصل على المفاتيح من لوحة تحكم Chargily Pay: https://pay.chargily.com
CHARGILY_SECRET_KEY=test_sk_your_chargily_secret_key_here
CHARGILY_MODE=test

# Success & Failure Redirection URLs
PAYMENT_SUCCESS_URL=https://naja7t.com/payment/success
PAYMENT_FAILURE_URL=https://naja7t.com/payment/failure
