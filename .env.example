# ==========================================
# إعدادات السيرفر وبيئة التشغيل (Server Config)
# ==========================================
PORT=5000
NODE_ENV=production
APP_NAME=Naja7t API Server
FRONTEND_URL=https://naja7t.com
ALLOWED_ORIGINS=*

# ==========================================
# إعدادات قاعدة البيانات (MySQL Database)
# ==========================================
# اختر 'mysql' للاستضافة الحقيقية، أو 'sqlite' للاختبار المحلي
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=naja7t_db
DB_STORAGE=./naja7t_v2.sqlite

# ==========================================
# مفتاح تشفير بيانات صفحة النجاح (Security)
# ==========================================
ENCRYPTION_SECRET=naja7t_secret_key_encryption_2026_dzd

# ==========================================
# بوابة الدفع الإلكتروني (Chargily Pay V2)
# ==========================================
CHARGILY_SECRET_KEY=test_sk_your_chargily_secret_key_here
CHARGILY_MODE=test

# روابط إعادة التوجيه بعد الدفع
PAYMENT_SUCCESS_URL=https://naja7t.com/payment/success
PAYMENT_FAILURE_URL=https://naja7t.com/payment/failure

# ==========================================
# إعدادات البريد الإلكتروني (SMTP Email)
# ==========================================
# ضع هنا بيانات بريد استضافتك الجديدة (cPanel / Hostinger / Mail Server)
EMAIL_HOST=mail.yourdomain.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=contact@yourdomain.com
EMAIL_PASS=your_hosting_email_password
EMAIL_FROM="منصة نجحت التعليمية <contact@yourdomain.com>"
